#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	cargo fetch --locked

override_dh_auto_build:
	cargo build --release --locked -p ostrya-mountd --bin ostrya-mountd

# The suite reaches the network, so a package build passes nocheck.
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --locked -p ostrya-mountd --all-targets -- --nocapture
endif

# The units and the sysusers.d file are in systemd/. Debhelper compat 13 runs
# no dh_installsysusers, so ostrya-mountd.postinst runs systemd-sysusers.
override_dh_auto_install:
	install -Dm755 $(CURDIR)/../../target/release/ostrya-mountd \
		$(CURDIR)/debian/ostrya-mountd/usr/sbin/ostrya-mountd
	for unit in ostrya-mountd.socket ostrya-mountd.service ostrya-mountd@.service; do \
		install -Dm644 $(CURDIR)/systemd/$$unit \
			$(CURDIR)/debian/ostrya-mountd/usr/lib/systemd/system/$$unit; \
	done
	install -Dm644 $(CURDIR)/systemd/ostrya-mountd.sysusers \
		$(CURDIR)/debian/ostrya-mountd/usr/lib/sysusers.d/ostrya-mountd.conf

# The package installs the units and does not enable or start them.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_auto_clean:
