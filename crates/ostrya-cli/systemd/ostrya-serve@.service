# One `ostrya serve` server. The instance NAME reads the environment file
# /etc/ostrya/serve/NAME.conf:
#
#   OSTRYA_REPO          the absolute path of the repository to serve
#   OSTRYA_SERVE_ARGS    other arguments for `ostrya serve`, split at
#                        whitespace
#
# The other settings come from [ex-ostrya server] in the repository config.
# The user ostrya must be able to read and write the repository. The TLS key
# must be readable by the user ostrya.
[Unit]
Description=ostrya HTTP server %i
Documentation=man:ostrya-serve(1)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/ostrya/serve/%i.conf
ExecStart=/usr/bin/ostrya --repo ${OSTRYA_REPO} serve $OSTRYA_SERVE_ARGS
User=ostrya
Group=ostrya
Restart=on-failure
RestartSec=5s
# ReadWritePaths does not expand environment variables, so the unit makes
# /usr, /boot, and /etc read-only, and the repository can be in any other
# directory except /home, /root, and /run/user.
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# A listener on a port below 1024 needs CAP_NET_BIND_SERVICE.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
