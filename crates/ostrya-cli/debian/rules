#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	cargo fetch --locked

override_dh_auto_build:
	cargo build --release --locked -p ostrya-cli --bin ostrya

# The suite drives the ostree binary as its oracle and reaches the network,
# so a package build passes nocheck.
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --locked -p ostrya-cli --all-targets -- --nocapture
endif

# The unit and the sysusers.d file of ostrya serve are in systemd/. Debhelper
# compat 13 runs no dh_installsysusers, so ostrya.postinst runs
# systemd-sysusers.
override_dh_auto_install:
	install -Dm755 $(CURDIR)/../../target/release/ostrya \
		$(CURDIR)/debian/ostrya/usr/bin/ostrya
	install -Dm644 $(CURDIR)/systemd/ostrya-serve@.service \
		$(CURDIR)/debian/ostrya/usr/lib/systemd/system/ostrya-serve@.service
	install -Dm644 $(CURDIR)/systemd/ostrya.sysusers \
		$(CURDIR)/debian/ostrya/usr/lib/sysusers.d/ostrya.conf

# The package installs the unit and does not enable or start it.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_auto_clean:
